# Local development env for clear-mvp. Copy to .env and fill in.
#
# Plain config below is prefilled with the dev environment's values. Secrets
# (marked "Secret") are shared privately by the team after you register; see
# CONTRIBUTING.md. Without them the app still runs, with the features noted below
# switched off. Never paste secret values into chat, issues, PRs or AI tools.
# Deployed environments don't read this file; see the README's "Environment".

# ── clear-api ────────────────────────────────────────────────────────────────
# Server-only. Falls back to http://localhost:4000 in development; required in
# production. Point it at a local clear-api, or https://dev-api.clearinitiative.io.
API_URL=http://localhost:4000

# GraphQL endpoint. Defaults to ${API_URL}/graphql.
# GRAPHQL_URL=http://localhost:4000/graphql

# ── Map ──────────────────────────────────────────────────────────────────────
# Mapbox public token. Not shared by the team: create your own free one at
# https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional overrides for map layer data. Leave unset: in development the
# Blockages layer reads a local spike dump (/api/dev/logie-blockages) and
# Seismic reads live USGS (/api/dev/usgs-earthquakes). See
# docs/clear-api-logie-ingest.md. Deployed images ignore these unless the build
# passes them through (see the README).
# NEXT_PUBLIC_LOGIE_BLOCKAGES_URL=/api/logie/blockages
# NEXT_PUBLIC_USGS_EARTHQUAKES_URL=/api/usgs/earthquakes

# ── CLEAR Agent (server-only; /api/agent fails without these) ────────────────
# Mastra model-router string (`provider/model`). `anthropic/...` reads
# ANTHROPIC_API_KEY. Matches dev.
CLEAR_AGENT_MODEL=anthropic/claude-sonnet-5-5
# Secret. The Agent's dev Anthropic key, shared with the dev server, so your
# usage counts against it; use your own capped key if you prefer.
ANTHROPIC_API_KEY=
# The Agent's clear-api key, sent with every Conversation call next to the
# user's session; clear-api only accepts Conversation writes with both.
# Secret. The team's dev key only works against dev's clear-api
# (dev-api.clearinitiative.io). Against a local clear-api, mint your own there:
# bun run scripts/create-agent-user.ts
CLEAR_AGENT_API_KEY=

# NRC Find RAG API, called by the Agent's nrc_find tool (server-only).
# NRC's dev instance.
NRC_FIND_API_URL=https://find.app.nrc-dev.no
# Client-credentials JWT for client_id "clear-platform" (X-App-Authorization).
# Secret.
NRC_FIND_API_TOKEN=

# ── Feedback form (/api/feedback returns 503 without these) ──────────────────
# Secret.
NOTION_TOKEN=
# The dev feedback database.
NOTION_FEEDBACK_DB_ID=350dc98d7ae68086a479f691b1e3ff8f

# ── INFORM Severity (the inform.getSeverity query errors without it) ─────────
# Secret.
ACAPS_API_TOKEN=

# ── Error tracking ───────────────────────────────────────────────────────────
# GlitchTip (Sentry-compatible). Leave unset locally: the dev DSN would send
# your local errors into the dev environment's error feed.
# SENTRY_DSN=
# SENTRY_ENV=development
# NEXT_PUBLIC_SENTRY_DSN=
