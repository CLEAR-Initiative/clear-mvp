# Apollo API (clear-api backend) — server-only, never exposed to browser
# Required in production. Falls back to http://localhost:4000 in development.
API_URL=http://localhost:4000

# GraphQL endpoint — defaults to ${API_URL}/graphql if not set
# GRAPHQL_URL=http://localhost:4000/graphql

# API key for server-to-server GraphQL calls
# GRAPHQL_API_KEY=

# Mapbox (for crisis maps)
NEXT_PUBLIC_MAPBOX_TOKEN=

# LogIE Blockages slim GeoJSON (after Expo #317 clear-api ingest).
# Prefer the same-origin BFF (forwards session cookie to clear-api):
#   NEXT_PUBLIC_LOGIE_BLOCKAGES_URL=/api/logie/blockages
# When unset: Layers → Blockages is interactive only in development via
# GET /api/dev/logie-blockages (spike dump). See docs/clear-api-logie-ingest.md
# NEXT_PUBLIC_LOGIE_BLOCKAGES_URL=

# CLEAR Agent (server-only). The model is a Mastra model-router string
# (`provider/model`); the provider reads its own key, e.g. `anthropic/...`
# needs ANTHROPIC_API_KEY. Required for /api/agent; nothing else names a model.
CLEAR_AGENT_MODEL=
ANTHROPIC_API_KEY=
# The Agent's clear-api key, sent with every Conversation call next to the
# user's session; clear-api only accepts Conversation writes with both.
# Mint it in clear-api: bun run scripts/create-agent-user.ts
CLEAR_AGENT_API_KEY=

# NRC Find RAG API (server-only — never exposed to the browser).
# Called by the CLEAR Agent's nrc_find tool.
# Base URL of the NRC Find deployment.
NRC_FIND_API_URL=https://find.app.nrc-dev.no
# Client-credentials JWT for client_id "clear-platform" (X-App-Authorization).
NRC_FIND_API_TOKEN=
