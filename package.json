{
  "name": "clear-nextjs-frontend",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo -p 3000",
    "build": "next build",
    "vercel-build": "npm run prepare && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-messages.mjs",
    "check": "next lint && tsc --noEmit && node scripts/check-messages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e": "bash e2e/run-local.sh",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --build --wait db redis api web",
    "e2e:seed": "docker compose -f docker-compose.e2e.yml run --rm seed",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v --remove-orphans"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@mantine/notifications": "^8.3.0",
    "@sentry/nextjs": "^10.0.0",
    "@tabler/icons-react": "2.47.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "better-auth": "^1.5.2",
    "clear-nextjs-frontend": ".",
    "clsx": "^2.1.1",
    "next": "^15.2.3",
    "next-intl": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.25.50"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
