// Prisma schema for CLEAR — Crisis Learning, Early-warning, Anticipation, and Response
// Built on Better Auth + T3 Stack

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// BETTER AUTH MODELS (managed by Better Auth)
// =============================================================================

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // CLEAR-specific fields
  role         UserRole @default(OTHER)
  organization String?
  country      String?

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // CLEAR relations
  decisions         Decision[]
  auditDecisions    AuditDecision[]
  crises            Crisis[]         @relation("CrisisCreator")
  surveyTemplates   SurveyTemplate[] @relation("TemplateCreator")
  surveys           Survey[]         @relation("SurveyCreator")
  feedback          Feedback[]       @relation("UserFeedback")
  referralsSent     Referral[]       @relation("ReferralSender")
  referralsReceived Referral[]       @relation("ReferralReceiver")
  quickProfiles     QuickProfile[]   @relation("ProfileAssessor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// =============================================================================
// CORE DOMAIN MODELS
// =============================================================================

model Crisis {
  id                 String         @id @default(cuid())
  title              String
  type               CrisisType
  severity           CrisisSeverity
  location           String
  latitude           Float?
  longitude          Float?
  description        String?        @db.Text
  affectedPopulation Int            @default(0)
  status             CrisisStatus   @default(ACTIVE)
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  createdBy User       @relation("CrisisCreator", fields: [createdById], references: [id])
  decisions Decision[]
  alerts    Alert[]
  surveys   Survey[]

  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@map("crisis")
}

model Decision {
  id              String         @id @default(cuid())
  crisisId        String
  title           String
  decisionText    String         @db.Text
  rationale       String?        @db.Text
  confidenceScore Int            @default(50)
  optionA         String?
  optionB         String?
  optionC         String?
  selectedOption  SelectedOption
  outcome         String?        @db.Text
  madeById        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  crisis Crisis @relation(fields: [crisisId], references: [id], onDelete: Cascade)
  madeBy User   @relation(fields: [madeById], references: [id])

  @@index([crisisId])
  @@index([madeById])
  @@index([createdAt])
  @@map("decision")
}

model Alert {
  id          String        @id @default(cuid())
  crisisId    String
  type        AlertType
  severity    AlertSeverity
  message     String
  isActive    Boolean       @default(true)
  triggeredAt DateTime      @default(now())
  resolvedAt  DateTime?

  crisis Crisis @relation(fields: [crisisId], references: [id], onDelete: Cascade)

  @@index([crisisId])
  @@index([isActive])
  @@index([severity])
  @@map("alert")
}

model AuditDecision {
  id                 String            @id @default(cuid())
  title              String
  type               AuditDecisionType
  decisionMade       String            @db.Text
  rationale          String            @db.Text
  riskLevel          RiskLevel
  informationSources Json
  stakeholders       Json
  alternatives       String?           @db.Text
  locationLat        Float?
  locationLng        Float?
  locationAddress    String?
  deviceId           String            @default("unknown")
  status             AuditStatus       @default(DRAFT)
  syncStatus         SyncStatus        @default(PENDING)
  tags               Json              @default("[]")
  priority           Priority          @default(NORMAL)
  cryptoHash         String?
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  createdBy User       @relation(fields: [createdById], references: [id])
  evidence  Evidence[]

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("audit_decision")
}

model Evidence {
  id              String       @id @default(cuid())
  auditDecisionId String
  type            EvidenceType
  filename        String
  size            Int
  hash            String?
  metadata        Json?
  createdAt       DateTime     @default(now())

  auditDecision AuditDecision @relation(fields: [auditDecisionId], references: [id], onDelete: Cascade)

  @@index([auditDecisionId])
  @@map("evidence")
}

model Feedback {
  id            String           @id @default(cuid())
  type          FeedbackType
  pageUrl       String
  feedbackText  String?          @db.Text
  rating        Int? // 1-5
  category      String?
  priority      FeedbackPriority @default(MEDIUM)
  status        FeedbackStatus   @default(NEW)
  screenshotUrl String?
  sessionId     String?
  userAgent     String?
  deviceType    String?
  userId        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User? @relation("UserFeedback", fields: [userId], references: [id])

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

// =============================================================================
// SURVEY SYSTEM
// =============================================================================

model SurveyTemplate {
  id                String         @id @default(cuid())
  name              String
  description       String?        @db.Text
  category          SurveyCategory
  estimatedDuration Int? // minutes
  isActive          Boolean        @default(true)
  version           String         @default("1.0")
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  createdBy User             @relation("TemplateCreator", fields: [createdById], references: [id])
  questions SurveyQuestion[]
  surveys   Survey[]

  @@index([category])
  @@index([isActive])
  @@map("survey_template")
}

model SurveyQuestion {
  id              String       @id @default(cuid())
  templateId      String
  questionNumber  Int
  questionText    String       @db.Text
  questionType    QuestionType
  isRequired      Boolean      @default(false)
  options         Json? // For choice-based questions: string[]
  validationRules Json? // { min, max, regex, etc. }
  helpText        String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  template  SurveyTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@unique([templateId, questionNumber])
  @@index([templateId])
  @@map("survey_question")
}

model Survey {
  id              String       @id @default(cuid())
  templateId      String
  crisisId        String?
  title           String
  description     String?      @db.Text
  status          SurveyStatus @default(DRAFT)
  startDate       DateTime?
  endDate         DateTime?
  targetResponses Int?
  isAnonymous     Boolean      @default(true)
  createdById     String
  deployedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  template        SurveyTemplate     @relation(fields: [templateId], references: [id])
  crisis          Crisis?            @relation(fields: [crisisId], references: [id])
  createdBy       User               @relation("SurveyCreator", fields: [createdById], references: [id])
  submissions     SurveySubmission[]
  koboDeployments KoboDeployment[]

  @@index([templateId])
  @@index([crisisId])
  @@index([status])
  @@map("survey")
}

model SurveySubmission {
  id             String           @id @default(cuid())
  surveyId       String
  respondentId   String?
  status         SubmissionStatus @default(IN_PROGRESS)
  startedAt      DateTime         @default(now())
  submittedAt    DateTime?
  totalTimeSpent Int? // seconds
  location       String?
  latitude       Float?
  longitude      Float?
  isComplete     Boolean          @default(false)

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([surveyId])
  @@index([status])
  @@index([isComplete])
  @@map("survey_submission")
}

model SurveyResponse {
  id              String    @id @default(cuid())
  surveyId        String
  submissionId    String
  questionId      String
  responseText    String?   @db.Text
  responseNumber  Float?
  responseBoolean Boolean?
  responseDate    DateTime?
  responseJson    Json? // For complex responses (multi-select, etc.)
  isSkipped       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  submission SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   SurveyQuestion   @relation(fields: [questionId], references: [id])

  @@unique([submissionId, questionId])
  @@index([surveyId])
  @@index([submissionId])
  @@map("survey_response")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  FIELD_COORDINATOR
  PROGRAM_MANAGER
  COUNTRY_DIRECTOR
  HUMANITARIAN_COORDINATOR
  LOGISTICS_OFFICER
  ADMIN
  OTHER
}

enum CrisisType {
  NATURAL_DISASTER
  CONFLICT
  EPIDEMIC
  FAMINE
  REFUGEE_CRISIS
  ECONOMIC_CRISIS
  OTHER
}

enum CrisisSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum CrisisStatus {
  ACTIVE
  MONITORING
  RESOLVED
  ARCHIVED
}

enum SelectedOption {
  OPTION_A
  OPTION_B
  OPTION_C
  OTHER
}

enum AlertType {
  THRESHOLD_EXCEEDED
  NEW_CRISIS_DETECTED
  DATA_ANOMALY
  SYSTEM_HEALTH
  OTHER
}

enum AlertSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AuditDecisionType {
  SECURITY_RESPONSE
  RESOURCE_ALLOCATION
  BENEFICIARY_SELECTION
  PROGRAM_MODIFICATION
  PARTNER_MANAGEMENT
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AuditStatus {
  DRAFT
  SUBMITTED
  SYNCED
  ARCHIVED
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
  FAILED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EvidenceType {
  DOCUMENT
  IMAGE
  AUDIO
  VIDEO
  OTHER
}

enum SurveyCategory {
  RAPID_ASSESSMENT
  MONITORING
  EVALUATION
  FEEDBACK
  REGISTRATION
  NEEDS_ASSESSMENT
  POST_DISTRIBUTION
  BASELINE
  ENDLINE
  OTHER
}

enum QuestionType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE
  LOCATION
  BOOLEAN
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  GENERAL
  PAGE_COMMENT
  FLOW_RATING
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FeedbackStatus {
  NEW
  REVIEWING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// =============================================================================
// KOBOTOOLBOX INTEGRATION
// =============================================================================

enum KoboSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

model KoboDeployment {
  id              String         @id @default(cuid())
  surveyId        String
  koboAssetUid    String // KoBo asset UID
  koboFormTitle   String
  deploymentUrl   String? // Enketo web form URL
  lastSyncedAt    DateTime?
  syncStatus      KoboSyncStatus @default(PENDING)
  syncError       String?
  submissionCount Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([koboAssetUid])
  @@index([surveyId])
  @@index([syncStatus])
  @@map("kobo_deployment")
}

// =============================================================================
// SECURE REFERRAL SYSTEM
// =============================================================================

enum OrganizationType {
  UN_AGENCY
  INGO
  LOCAL_NGO
  GOVERNMENT
  RED_CROSS_CRESCENT
  COMMUNITY_BASED
  PRIVATE_SECTOR
  OTHER_ORG
}

enum ReferralType {
  INDIVIDUAL_CASE
  FAMILY_CASE
  GROUP_REFERRAL
  EMERGENCY_TRANSFER
  INFORMATION_SHARING
}

enum ReferralStatus {
  DRAFT
  SENT
  RECEIVED
  ACCEPTED
  IN_PROGRESS_REFERRAL
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ReferralUrgency {
  ROUTINE
  PRIORITY
  URGENT
  EMERGENCY
}

enum ConsentType {
  DATA_SHARING
  SERVICE_PROVISION
  CROSS_BORDER_TRANSFER
  THIRD_PARTY_DISCLOSURE
}

model PartnerOrganization {
  id               String           @id @default(cuid())
  name             String
  organizationType OrganizationType
  sector           String? // e.g., "Protection", "Health", "WASH"
  contactEmail     String?
  contactPhone     String?
  serviceTypes     Json             @default("[]") // string[] of services offered
  operationalAreas Json             @default("[]") // string[] of operating regions
  isVerified       Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  referralsFrom Referral[] @relation("ReferralFromOrg")
  referralsTo   Referral[] @relation("ReferralToOrg")

  @@index([organizationType])
  @@index([isActive])
  @@map("partner_organization")
}

model Referral {
  id                 String          @id @default(cuid())
  referralType       ReferralType
  urgency            ReferralUrgency @default(ROUTINE)
  status             ReferralStatus  @default(DRAFT)
  fromOrganizationId String
  toOrganizationId   String
  serviceRequested   String          @db.Text
  beneficiaryData    String          @db.Text // AES-256-GCM encrypted JSON
  encryptionIv       String // initialization vector (hex)
  encryptionSalt     String // PBKDF2 salt (hex)
  encryptionTag      String // GCM auth tag (hex)
  notes              String?         @db.Text
  sentById           String
  receivedById       String?
  sentAt             DateTime?
  receivedAt         DateTime?
  completedAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  fromOrganization PartnerOrganization @relation("ReferralFromOrg", fields: [fromOrganizationId], references: [id])
  toOrganization   PartnerOrganization @relation("ReferralToOrg", fields: [toOrganizationId], references: [id])
  sentBy           User                @relation("ReferralSender", fields: [sentById], references: [id])
  receivedBy       User?               @relation("ReferralReceiver", fields: [receivedById], references: [id])
  consents         ReferralConsent[]

  @@index([status])
  @@index([fromOrganizationId])
  @@index([toOrganizationId])
  @@index([sentById])
  @@index([createdAt])
  @@map("referral")
}

model ReferralConsent {
  id               String      @id @default(cuid())
  referralId       String
  consentType      ConsentType
  isGranted        Boolean     @default(false)
  grantedBy        String? // name of person granting consent
  consentText      String?     @db.Text
  digitalSignature String? // base64 signature data
  grantedAt        DateTime?
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@map("referral_consent")
}

// =============================================================================
// VULNERABILITY ASSESSMENT
// =============================================================================

enum PrimaryNeedType {
  FOOD
  SHELTER
  WASH
  HEALTH
  PROTECTION
}

enum RiskCategory {
  CRITICAL
  HIGH
  MEDIUM_RISK
  LOW_RISK
}

model QuickProfile {
  id                 String          @id @default(cuid())
  siteId             String?
  householdSize      Int
  femaleHeaded       Boolean         @default(false)
  hasVulnerable      Boolean         @default(false)
  pwdCount           Int             @default(0) // persons with disabilities
  elderlyCount       Int             @default(0)
  childHeaded        Boolean         @default(false)
  primaryNeed        PrimaryNeedType
  serviceDistance    Float? // km to nearest services
  gbvRisk            Boolean         @default(false)
  latitude           Float?
  longitude          Float?
  vulnerabilityScore Int             @default(0) // 0-100
  riskCategory       RiskCategory    @default(LOW_RISK)
  priorityRank       Int             @default(5) // 1-5, 1=highest
  assessmentDuration Int? // seconds
  assessedById       String
  assessedAt         DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assessedBy          User                @relation("ProfileAssessor", fields: [assessedById], references: [id])
  vulnerabilityDetail VulnerabilityScore?

  @@index([riskCategory])
  @@index([assessedById])
  @@index([assessedAt])
  @@map("quick_profile")
}

model VulnerabilityScore {
  id                     String       @id @default(cuid())
  quickProfileId         String       @unique
  totalScore             Int // 0-100
  riskCategory           RiskCategory
  priorityRank           Int // 1-5
  femaleHeadedScore      Int          @default(0)
  vulnerableMembersScore Int          @default(0)
  householdSizeScore     Int          @default(0)
  primaryNeedScore       Int          @default(0)
  serviceDistanceScore   Int          @default(0)
  gbvRiskScore           Int          @default(0)
  eligiblePrograms       Json         @default("[]") // string[]
  calculatedAt           DateTime     @default(now())

  quickProfile QuickProfile @relation(fields: [quickProfileId], references: [id], onDelete: Cascade)

  @@map("vulnerability_score")
}

// =============================================================================
// DATA SOURCE INTELLIGENCE
// =============================================================================

enum DataSourceType {
  API
  DATABASE
  SURVEY
  MANUAL
  SATELLITE
  IOT
  SOCIAL_MEDIA
  OTHER_SOURCE
}

enum QualityDimension {
  COMPLETENESS
  ACCURACY
  CONSISTENCY
  TIMELINESS
  VALIDITY
}

model DataSource {
  id               String         @id @default(cuid())
  name             String
  sourceType       DataSourceType
  sector           String // protection, health, nutrition, wash, shelter, education, livelihoods
  apiEndpoint      String?
  updateFrequency  String         @default("monthly") // daily, weekly, monthly, quarterly
  coverageAreas    Json           @default("[]") // string[] geographic areas
  populations      Json           @default("[]") // string[] target populations
  indicators       Json           @default("[]") // string[] available indicators
  qualityLevel     String         @default("medium") // high, medium, low
  accessLevel      String         @default("public") // public, partner, restricted
  isActive         Boolean        @default(true)
  reliabilityScore Float          @default(0.5) // 0-1
  lastSyncedAt     DateTime?
  lastSyncStatus   String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  availabilityLogs DataSourceAvailability[]
  qualityMetrics   DataQualityMetric[]

  @@index([sector])
  @@index([isActive])
  @@index([sourceType])
  @@map("data_source")
}

model DataSourceAvailability {
  id           String   @id @default(cuid())
  sourceId     String
  isAvailable  Boolean
  responseTime Int? // milliseconds
  errorMessage String?
  recordCount  Int?
  checkedAt    DateTime @default(now())

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([checkedAt])
  @@map("data_source_availability")
}

model DataQualityMetric {
  id               String           @id @default(cuid())
  sourceId         String
  indicator        String
  qualityDimension QualityDimension
  score            Float // 0-1
  threshold        Float            @default(0.7)
  isPassing        Boolean          @default(true)
  details          Json?
  measuredAt       DateTime         @default(now())

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([qualityDimension])
  @@map("data_quality_metric")
}
